# 从仓库根目录运行；DEMO_HOST 为电脑的局域网 IP。
https://{$DEMO_HOST} {
    tls internal
    root * ./frontend

    handle /api/* {
        reverse_proxy 127.0.0.1:8000 {
            header_up Authorization "Bearer {$API_TOKEN}"
        }
    }

    handle /data/species/* {
        root * .
        file_server
    }

    handle /data/sites.json {
        root * .
        file_server
    }

    handle /data/* {
        respond 404
    }

    handle_path /assets/* {
        root * ./assets
        file_server
    }

    handle {
        file_server
    }
}
